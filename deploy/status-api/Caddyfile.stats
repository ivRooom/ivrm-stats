stats.ivrm.jp {
    route {
        @status_ingest path /api/internal/status-ingest
        reverse_proxy @status_ingest status-api:8080

        @status_public path /api/status.json
        reverse_proxy @status_public status-api:8080

        @status_history path /api/status-history.json
        reverse_proxy @status_history status-api:8080

        header {
            X-Content-Type-Options nosniff
            Referrer-Policy no-referrer
            X-Frame-Options DENY
        }

        root * /srv/stats
        encode zstd gzip
        file_server
    }
}
